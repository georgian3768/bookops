# BookOps SMTP configuration example.
# Copy to msmtprc.local, fill in your details, then: chmod 600 msmtprc.local
# msmtprc.local is gitignored and must never be committed.

defaults
auth             on
tls              on
tls_trust_file   /etc/ssl/certs/ca-certificates.crt

account          default
host             smtp.gmail.com
port             587
from             you@gmail.com
user             you@gmail.com
# Gmail requires an App Password, not your account password:
# https://myaccount.google.com/apppasswords
password         your-16-character-app-password
